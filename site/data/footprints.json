4.87,"lng":110.45},"jizhou":{"n":"济州","m":"茌平","lat":36.58,"lng":116.25},"liangzhou":{"n":"凉州","m":"武威","lat":37.93,"lng":102.64},"xiangyang":{"n":"襄阳","lat":32.01,"lng":112.12},"wangchuan":{"n":"辋川","m":"蓝田","lat":34.15,"lng":109.32},"nanzheng":{"n":"南郑","m":"汉中","lat":33.07,"lng":107.03},"jianmen":{"n":"剑门","m":"剑阁","lat":32.2,"lng":105.55},"zaokou":{"n":"造口","m":"万安","lat":26.46,"lng":114.79},"shangrao":{"n":"信州","m":"上饶","lat":28.45,"lng":117.94},"jingkou":{"n":"京口","m":"镇江","lat":32.2,"lng":119.45},"qingzhou":{"n":"青州","lat":36.7,"lng":118.48},"jinhua":{"n":"金华","lat":29.08,"lng":119.65}},"poets":{"李白":{"b":701,"d":762,"stops":[{"p":"jiangyou","y":[705,724],"e":"幼年随家迁居绵州昌隆（今江油），在这里读书、学剑，少年时已能作诗。","poems":[{"t":"访戴天山道士不遇","f":"犬吠水声中","c":8940}]},{"p":"emei","y":[724,725],"e":"辞亲远游，沿平羌江、岷江顺流东下，离开蜀地。","poems":[{"t":"峨眉山月歌","f":"峨眉山月半轮秋","y":725,"c":8399}]},{"p":"jingmen","y":[725],"e":"出三峡，过荆门山，眼前第一次是开阔的楚地平原。","poems":[{"t":"渡荆门送别","f":"渡远荆门外","y":725,"c":8616}]},{"p":"lushan","y":[725,726],"e":"东游途中登庐山。","poems":[{"t":"望庐山瀑布","f":"日照香炉生紫烟","d":16}]},{"p":"jinling","y":[726],"e":"漫游金陵，结交当地少年，离开时写诗留别。","poems":[{"t":"金陵酒肆留别","f":"风吹柳花满店香","y":726,"c":8606}]},{"p":"anlu","y":[727,736],"e":"在安陆娶故相许圉师的孙女，以此为家，自称「酒隐安陆，蹉跎十年」。"},{"p":"wuchang","y":[730],"e":"在黄鹤楼送孟浩然东下广陵。","poems":[{"t":"黄鹤楼送孟浩然之广陵","f":"故人西辞黄鹤楼","d":38}]},{"p":"luoyang","y":[735,744],"e":"数次客居洛阳；天宝三载（744）在这里与杜甫相识，此后同游梁宋。","poems":[{"t":"春夜洛城闻笛","f":"谁家玉笛暗飞声","c":9034}]},{"p":"changan","y":[742,744],"e":"奉诏入京，供奉翰林；不到两年被「赐金放还」。","poems":[{"t":"清平调","f":"云想衣裳花想容","y":743,"c":50289},{"t":"行路难","f":"金樽清酒斗十千","y":744,"c":8195}]},{"p":"yanzhou","y":[745,746],"e":"寓居东鲁，在石门送别杜甫；又辞别东鲁诸公，南游吴越。","poems":[{"t":"鲁郡东石门送杜二甫","f":"醉别复几日","y":745,"c":8646},{"t":"梦游天姥吟留别","f":"海客谈瀛洲","y":746,"c":8592}]},{"p":"xuancheng","y":[753,755],"e":"晚年往来宣城一带，登敬亭山、谢朓楼；在泾县桃花潭作别汪伦。","poems":[{"t":"独坐敬亭山","f":"众鸟高飞尽","y":753,"c":8938},{"t":"宣州谢朓楼饯别校书叔云","f":"弃我去者","y":753,"c":8714},{"t":"赠汪伦","f":"李白乘舟将欲行","d":21}]},{"p":"kuizhou","y":[759],"e":"因从永王璘获罪，流放夜郎；行至白帝城遇赦，立刻放舟东还。","label":"白帝城","poems":[{"t":"早发白帝城","f":"朝辞白帝彩云间","y":759,"d":27}]},{"p":"dangtu","y":[762],"e":"晚年投奔当涂县令、族叔李阳冰，病逝于当涂。早年出蜀东下时曾过此地的天门山。","poems":[{"t":"望天门山","f":"天门中断楚江开","y":725,"d":24}]}]},"杜甫":{"b":712,"d":770,"stops":[{"p":"luoyang","y":[712,735],"e":"生于河南巩县（今巩义），少年时多在洛阳度过，七岁能诗。"},{"p":"taishan","y":[736],"e":"科举落第后漫游齐赵，北望泰山，写下少年意气。","poems":[{"t":"望岳","f":"岱宗夫如何","y":736,"c":10811}]},{"p":"luoyang","y":[744],"e":"在洛阳与李白相识，随后与李白、高适同游梁宋。"},{"p":"changan","y":[746,755],"e":"困守长安近十年，求仕不顺，生活清苦，开始写民间疾苦。","poems":[{"t":"兵车行","f":"车辚辚","y":751,"c":10817},{"t":"丽人行","f":"三月三日天气新","y":753,"c":10837}]},{"p":"changan","y":[756,757],"e":"安史之乱，被叛军困在沦陷的长安，望月思念鄜州的妻儿。","poems":[{"t":"月夜","f":"今夜鄜州月","y":756,"c":11313},{"t":"春望","f":"国破山河在","y":757,"c":11316}]},{"p":"fengxiang","y":[757],"e":"冒险逃出长安，到凤翔投奔肃宗，被任命为左拾遗。"},{"p":"shanzhou","y":[759],"e":"从洛阳回华州任所，一路目睹征兵之苦，写成「三吏」「三别」。","poems":[{"t":"石壕吏","f":"暮投石壕村","y":759,"c":10895}]},{"p":"qinzhou","y":[759],"e":"弃官西行，寄居秦州，秋夜思念离散的弟弟。","poems":[{"t":"月夜忆舍弟","f":"戍鼓断人行","y":759,"c":11395}]},{"p":"chengdu","y":[760,765],"e":"在成都浣花溪畔建草堂，得到几年较安定的日子。","poems":[{"t":"蜀相","f":"丞相祠堂何处寻","y":760,"c":11440},{"t":"春夜喜雨","f":"好雨知时节","y":761,"d":52},{"t":"茅屋为秋风所破歌","f":"八月秋高风怒号","y":761,"c":11001},{"t":"江畔独步寻花","f":"黄四娘家花满蹊","y":761,"d":51},{"t":"绝句","f":"两个黄鹂鸣翠柳","y":764,"d":15}]},{"p":"zizhou","y":[763],"e":"避乱梓州，听到官军收复河南河北，喜极而泣。","poems":[{"t":"闻官军收河南河北","f":"剑外忽传收蓟北","y":763,"c":11610}]},{"p":"kuizhou","y":[766,768],"e":"寓居夔州近两年，多病而诗兴极盛，律诗成就达到顶峰。","poems":[{"t":"秋兴八首","f":"玉露凋伤枫树林","y":766,"c":11887},{"t":"登高","f":"风急天高猿啸哀","y":767,"c":11653}]},{"p":"yuezhou","y":[768],"e":"出峡东下，漂泊至岳州，登岳阳楼。","poems":[{"t":"登岳阳楼","f":"昔闻洞庭水","y":768,"c":12183}]},{"p":"tanzhou","y":[770],"e":"在潭州重逢流落江南的乐师李龟年；同年冬，病逝于湘江的船上。","poems":[{"t":"江南逢李龟年","f":"岐王宅里寻常见","y":770,"c":12164}]}]},"苏轼":{"b":1037,"d":1101,"stops":[{"p":"meishan","y":[1037,1056],"e":"生于眉州眉山，随父亲苏洵读书，与弟弟苏辙一起长大。"},{"p":"bianjing","y":[1057,1061],"e":"与苏辙同榜进士，主考欧阳修十分赏识他的文章。","label":"汴京"},{"p":"fengxiang","y":[1061,1064],"e":"第一次做官，任凤翔府签判。"},{"p":"hangzhou","y":[1071,1074],"e":"因反对新法，自请外放，任杭州通判，写下许多西湖诗。","poems":[{"t":"六月二十七日望湖楼醉书","f":"黑云翻墨未遮山","y":1072,"c":105512},{"t":"饮湖上初晴后雨","f":"水光潋滟晴方好","y":1073,"d":25}]},{"p":"mizhou","y":[1074,1076],"e":"任密州知州。出城打猎、梦见亡妻、中秋怀念弟弟，都在这里写成。","poems":[{"t":"江城子·密州出猎","f":"老夫聊发少年狂","y":1075},{"t":"江城子·乙卯正月二十日夜记梦","f":"十年生死两茫茫","y":1075},{"t":"水调歌头","f":"明月几时有","y":1076}]},{"p":"xuzhou","y":[1077,1079],"e":"任徐州知州，黄河决口时亲自上城抗洪。"},{"p":"huzhou","y":[1079],"e":"到湖州任职才三个月，因「乌台诗案」被捕押往京城。"},{"p":"huangzhou","y":[1080,1084],"e":"贬为黄州团练副使，在东坡开荒种地，自号「东坡居士」，写下一生最有名的诗文。","poems":[{"t":"初到黄州","f":"自笑平生为口忙","y":1080,"c":106254},{"t":"定风波","f":"莫听穿林打叶声","y":1082},{"t":"念奴娇·赤壁怀古","f":"大江东去","y":1082},{"t":"赤壁赋","f":"壬戌之秋","y":1082,"x":1}]},{"p":"lushan","y":[1084],"e":"离开黄州改任汝州，途中游庐山。","poems":[{"t":"题西林壁","f":"横看成岭侧成峰","y":1084,"d":40}]},{"p":"bianjing","y":[1085,1089],"e":"旧党执政，回京任翰林学士。","label":"汴京","poems":[{"t":"惠崇春江晚景","f":"竹外桃花三两枝","y":1085,"d":29}]},{"p":"hangzhou","y":[1089,1091],"e":"再到杭州任知州，疏浚西湖，用湖泥筑成「苏堤」。","poems":[{"t":"赠刘景文","f":"荷尽已无擎雨盖","y":1090,"d":23}]},{"p":"huizhou","y":[1094,1097],"e":"新党再起，贬到惠州。","poems":[{"t":"惠州一绝","f":"罗浮山下四时春","y":1096,"q":"食荔支","c":107371}]},{"p":"danzhou","y":[1097,1100],"e":"以六十多岁之年再贬海南儋州，办学授徒。"},{"p":"changzhou","y":[1101],"e":"遇赦北归，病逝于常州。"}]},"白居易":{"b":772,"d":846,"stops":[{"p":"xinzheng","y":[772],"e":"生于河南新郑。"},{"p":"changan","y":[787,788],"e":"少年到长安应试，以诗谒见顾况，留下「居大不易」的故事。","poems":[{"t":"赋得古原草送别","f":"离离原上草","y":787,"d":13}]},{"p":"zhouzhi","y":[806,807],"e":"任盩厔县尉，与友人同游仙游寺，写成长篇叙事诗。","poems":[{"t":"长恨歌","f":"汉皇重色思倾国","y":806,"c":23028},{"t":"观刈麦","f":"田家少闲月","y":806,"c":22417}]},{"p":"changan","y":[807,815],"e":"任翰林学士、左拾遗，作《新乐府》《秦中吟》讽喻时事。","poems":[{"t":"卖炭翁","f":"卖炭翁","y":809,"c":22589}]},{"p":"lushan","y":[815,818],"e":"因上书言事被贬为江州司马，在浔阳江头听琵琶女弹奏。","label":"江州","poems":[{"t":"琵琶行","f":"浔阳江头夜送客","y":816,"q":"琵琶引","c":23034},{"t":"大林寺桃花","f":"人间四月芳菲尽","y":817,"c":23398}]},{"p":"zhongzhou","y":[819,820],"e":"任忠州刺史。"},{"p":"hangzhou","y":[822,824],"e":"任杭州刺史，修筑湖堤，蓄水灌田。","poems":[{"t":"钱塘湖春行","f":"孤山寺北贾亭西","y":823,"q":"钱唐湖春行","c":23801}]},{"p":"suzhou","y":[825,826],"e":"任苏州刺史。"},{"p":"luoyang","y":[829,846],"e":"晚年定居洛阳履道里，自号香山居士，回忆江南写成小词，卒于洛阳。","poems":[{"t":"忆江南","f":"江南好","y":838,"d":65}]}]},"王维":{"b":701,"d":761,"stops":[{"p":"puzhou","y":[701,715],"e":"祖籍太原祁县，父亲迁居蒲州，王维在这里长大。"},{"p":"changan","y":[717],"e":"十七岁客居长安，重阳节思念家乡的兄弟。","poems":[{"t":"九月九日忆山东兄弟","f":"独在异乡为异客","y":717,"d":31}]},{"p":"jizhou","y":[721,725],"e":"考中进士不久，因属下舞黄狮子获罪，贬为济州司仓参军。"},{"p":"liangzhou","y":[737],"e":"以监察御史身份出使凉州，慰问河西边军。","poems":[{"t":"使至塞上","f":"单车欲问边","y":737,"c":6172}]},{"p":"xiangyang","y":[740],"e":"知南选途经襄阳，泛舟汉江。","poems":[{"t":"汉江临泛","f":"楚塞三湘接","y":740,"c":6168}]},{"p":"wangchuan","y":[745,759],"e":"在蓝田辋川得到宋之问的旧别墅，半官半隐，与裴迪唱和成《辋川集》。","poems":[{"t":"山居秋暝","f":"空山新雨后","c":6155},{"t":"鹿柴","f":"空山不见人","d":57},{"t":"竹里馆","f":"独坐幽篁里","c":6283}]},{"p":"changan","y":[756,761],"e":"安史之乱中被迫接受伪职，乱平后获宽宥，官至尚书右丞，卒于长安。在渭城（今咸阳）送友人出使安西的诗也作于长安一带。","poems":[{"t":"送元二使安西","f":"渭城朝雨浥轻尘","d":39}]}]},"陆游":{"b":1125,"d":1210,"stops":[{"p":"shanyin","y":[1125,1153],"e":"生于北宋末年，金兵南下时随家逃难，后回到越州山阴故里，自幼立志收复中原。"},{"p":"hangzhou","y":[1153,1154],"e":"赴临安应试名列前茅，因名次在秦桧孙子之前、又力主抗金，被除名。","label":"临安"},{"p":"shanyin","y":[1166,1169],"e":"因支持北伐被罢官，回山阴闲居，到邻村游玩。","poems":[{"t":"游山西村","f":"莫笑农家腊酒浑","y":1167,"d":41}]},{"p":"kuizhou","y":[1170,1172],"e":"入蜀任夔州通判，沿途写成《入蜀记》。"},{"p":"nanzheng","y":[1172],"e":"到南郑前线，在四川宣抚使王炎幕中，这是他一生唯一亲临抗金前线的日子。"},{"p":"jianmen","y":[1172],"e":"王炎被召回，幕府解散，陆游调往成都，骑驴过剑门。","poems":[{"t":"剑门道中遇微雨","f":"衣上征尘杂酒痕","y":1172,"c":190980}]},{"p":"chengdu","y":[1173,1178],"e":"在成都范成大幕中任职，因不拘礼法被讥「颓放」，自号「放翁」。"},{"p":"shanyin","y":[1186],"e":"罢官家居多年，回首壮志未酬。","poems":[{"t":"书愤","f":"早岁那知世事艰","y":1186,"c":192866}]},{"p":"hangzhou","y":[1186],"e":"奉召入京等候任命，客居临安。","label":"临安","poems":[{"t":"临安春雨初霁","f":"世味年来薄似纱","y":1186,"c":192869}]},{"p":"shanyin","y":[1190,1210],"e":"晚年退居山阴二十年，至死不忘北伐。","poems":[{"t":"十一月四日风雨大作","f":"僵卧孤村不自哀","y":1192,"c":193840},{"t":"冬夜读书示子聿","f":"古人学问无遗力","y":1199,"c":195550},{"t":"示儿","f":"死去元知万事空","y":1210,"d":42}]}]},"辛弃疾":{"b":1140,"d":1207,"stops":[{"p":"jinan","y":[1140,1161],"e":"生于金人统治下的济南历城；二十一岁聚众抗金，投奔耿京义军。"},{"p":"jinling","y":[1162,1174],"e":"率五十骑突入金营擒获叛徒张安国，南归宋朝；后在建康任职，登赏心亭远望。","label":"建康","poems":[{"t":"水龙吟·登建康赏心亭","f":"楚天千里清秋"}]},{"p":"zaokou","y":[1176],"e":"任江西提点刑狱，过造口，想起当年隆祐太后被金兵追赶的往事。","poems":[{"t":"菩萨蛮·书江西造口壁","f":"郁孤台下清江水","y":1176}]},{"p":"wuchang","y":[1179],"e":"由湖北转运副使调任湖南，同僚置酒送别。","poems":[{"t":"摸鱼儿","f":"更能消几番风雨","y":1179}]},{"p":"shangrao","y":[1181,1192],"e":"被弹劾罢官，闲居信州带湖二十年中的头十年，写下许多田园词。","label":"信州带湖","poems":[{"t":"清平乐·村居","f":"茅檐低小"},{"t":"西江月·夜行黄沙道中","f":"明月别枝惊鹊"},{"t":"丑奴儿·书博山道中壁","f":"少年不识愁滋味"}]},{"p":"jingkou","y":[1204,1205],"e":"年过六十再被起用，任镇江知府，登北固亭怀古。","poems":[{"t":"南乡子·登京口北固亭有怀","f":"何处望神州","y":1204},{"t":"永遇乐·京口北固亭怀古","f":"千古江山","y":1205}]},{"p":"shangrao","y":[1205,1207],"e":"又被罢免，退居铅山瓢泉，病逝。","label":"铅山瓢泉"}]},"李清照":{"b":1084,"d":1155,"stops":[{"p":"jinan","y":[1084,1100],"e":"生于齐州章丘（今属济南），父亲李格非是苏轼门下的学者。"},{"p":"bianjing","y":[1101,1106],"e":"十八岁在汴京嫁给太学生赵明诚，夫妇共同收集金石书画。","label":"汴京"},{"p":"qingzhou","y":[1107,1127],"e":"随赵明诚屏居青州故里十余年，整理《金石录》。"},{"p":"jinling","y":[1128,1129],"e":"靖康之变后南渡，到建康；赵明诚病逝于此。","label":"建康","poems":[{"t":"夏日绝句","f":"生当作人杰","y":1129,"u":"写作地点有不同说法","d":44}]},{"p":"jinhua","y":[1134,1135],"e":"避乱流寓金华，登八咏楼。","poems":[{"t":"武陵春","f":"风住尘香花已尽","y":1135},{"t":"题八咏楼","f":"千古风流八咏楼","y":1135,"q":"八咏楼","c":153897}]},{"p":"hangzhou","y":[1135,1155],"e":"晚年定居临安，孤身整理亡夫遗著，元宵感怀旧日汴京。","label":"临安","poems":[{"t":"永遇乐","f":"落日熔金"}]}]}}}